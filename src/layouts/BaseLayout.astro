---
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description?: string;
  width?: 'narrow' | 'wide';
}
const { title, description, width = 'narrow' } = Astro.props;
const container = width === 'wide' ? 'max-w-5xl' : 'max-w-3xl';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <Header />
    <main class:list={[container, 'mx-auto px-4 py-10']}>
      <slot />
    </main>
  </body>
</html>

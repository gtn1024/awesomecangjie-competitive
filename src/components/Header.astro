---
const repoUrl = 'https://github.com/gtn1024/awesomecangjie-competitive';
---

<header
  class="sticky top-0 z-50 backdrop-blur-md border-b"
  style="background: color-mix(in oklab, var(--bg) 80%, transparent); border-color: var(--border);"
>
  <nav class="max-w-3xl mx-auto px-4 h-14 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <button
        type="button"
        data-sidebar-toggle
        aria-label="切换侧边栏"
        class="lg:hidden w-8 h-8 flex items-center justify-center rounded-[var(--radius-tag)] border transition-colors hover:bg-[var(--bg-hover)]"
        style="border-color: var(--border); color: var(--text-dim);"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
      </button>
      <a
        href="/"
        class="font-mono text-sm font-semibold tracking-tight hover:text-[var(--color-accent)] transition-colors"
        style="color: var(--text);"
      >
        <span class="text-[var(--color-accent)]">◆</span> awesome-cangjie
      </a>
    </div>

    <div class="flex items-center gap-1">
      <button
        id="theme-toggle"
        type="button"
        aria-label="切换主题"
        class="w-8 h-8 flex items-center justify-center rounded-[var(--radius-tag)] border transition-colors hover:bg-[var(--bg-hover)]"
        style="border-color: var(--border); color: var(--text-dim);"
      >
        <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
        <svg class="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>

      <a
        href={repoUrl}
        target="_blank"
        rel="noopener"
        aria-label="GitHub 仓库"
        class="w-8 h-8 flex items-center justify-center rounded-[var(--radius-tag)] border transition-colors hover:bg-[var(--bg-hover)]"
        style="border-color: var(--border); color: var(--text-dim);"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.37.5 0 5.78 0 12.29c0 5.21 3.44 9.63 8.21 11.19.6.11.82-.25.82-.56 0-.28-.01-1.02-.02-2-3.34.71-4.04-1.58-4.04-1.58-.55-1.37-1.34-1.74-1.34-1.74-1.09-.73.08-.72.08-.72 1.21.08 1.85 1.22 1.85 1.22 1.07 1.8 2.81 1.28 3.5.98.11-.76.42-1.28.76-1.57-2.67-.3-5.47-1.31-5.47-5.83 0-1.29.47-2.34 1.24-3.17-.12-.3-.54-1.52.12-3.17 0 0 1.01-.32 3.3 1.21.96-.26 1.98-.39 3-.4 1.02.01 2.04.14 3 .4 2.29-1.53 3.3-1.21 3.3-1.21.66 1.65.24 2.87.12 3.17.77.83 1.24 1.88 1.24 3.17 0 4.53-2.81 5.53-5.49 5.82.43.36.81 1.08.81 2.18 0 1.58-.01 2.85-.01 3.24 0 .31.22.68.83.56A12.01 12.01 0 0 0 24 12.29C24 5.78 18.63.5 12 .5z"/></svg>
      </a>
    </div>
  </nav>
</header>

<style>
  .icon-sun { display: none; }
  .icon-moon { display: block; }
  :global(html.light) .icon-sun { display: block; }
  :global(html.light) .icon-moon { display: none; }
</style>

<script is:inline>
  (function () {
    const stored = localStorage.getItem('theme');
    const systemLight = window.matchMedia('(prefers-color-scheme: light)').matches;
    const useLight = stored ? stored === 'light' : systemLight;
    if (!useLight) document.documentElement.classList.remove('light');
    else document.documentElement.classList.add('light');
    document.documentElement.classList.add('theme-ready');
  })();
</script>

<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const isLight = document.documentElement.classList.toggle('light');
    localStorage.setItem('theme', isLight ? 'light' : 'dark');
  });
</script>

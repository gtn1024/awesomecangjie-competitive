---
import type { Pagination } from '../lib/problem';

interface Props {
  oj: string;
  pagination: Pagination;
}
const { oj, pagination } = Astro.props;
const { items, page, totalPages } = pagination;
---

{items.length === 0 ? (
  <p class="font-mono text-sm" style="color: var(--text-faint);">暂无题目</p>
) : (
  <Fragment>
    <ul class="space-y-1 mb-8">
      {items.map((p) => (
        <li>
          <a
            href={`/${oj}/solution/${p.pid}`}
            class="group flex items-baseline gap-3 rounded-[var(--radius-tag)] px-3 py-2.5 transition-colors hover:bg-[var(--bg-hover)] active:translate-y-px"
          >
            <span class="font-mono text-sm shrink-0" style="color: var(--color-accent);">
              #{p.pid}
            </span>
            <span class="text-sm flex-1" style="color: var(--text);">
              {p.title}
            </span>
          </a>
        </li>
      ))}
    </ul>

    {totalPages > 1 && (
      <nav class="flex items-center gap-2 font-mono text-xs" aria-label="分页">
        {page > 1 ? (
          <a
            href={page === 2 ? `/${oj}/` : `/${oj}/page/${page - 1}`}
            class="px-2 py-1 rounded-[var(--radius-tag)] border transition-colors hover:bg-[var(--bg-hover)]"
            style="border-color: var(--border); color: var(--text-dim);"
          >
            ← 上一页
          </a>
        ) : (
          <span class="px-2 py-1 opacity-30" style="color: var(--text-faint);">← 上一页</span>
        )}
        <span style="color: var(--text-faint);">
          {page} / {totalPages}
        </span>
        {page < totalPages ? (
          <a
            href={`/${oj}/page/${page + 1}`}
            class="px-2 py-1 rounded-[var(--radius-tag)] border transition-colors hover:bg-[var(--bg-hover)]"
            style="border-color: var(--border); color: var(--text-dim);"
          >
            下一页 →
          </a>
        ) : (
          <span class="px-2 py-1 opacity-30" style="color: var(--text-faint);">下一页 →</span>
        )}
      </nav>
    )}
  </Fragment>
)}
